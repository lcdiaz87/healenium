  "type": "module",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@wdio/cli": "^9.31.3",
    "@wdio/cucumber-framework": "^9.31.2",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.3",
    "@wdio/spec-reporter": "^9.31.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "edgedriver@6.3.0": true,
    "geckodriver@6.1.1": true
  }
