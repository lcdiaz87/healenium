  "main": "index.js",
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "test:healed": "wdio run ./wdio.healenium.conf.ts",
    "healenium:up": "docker compose -f healenium/docker-compose.yaml up -d && wait-on -t 120000 http://127.0.0.1:7878/healing tcp:127.0.0.1:4444 tcp:127.0.0.1:8085",
    "healenium:down": "docker compose -f healenium/docker-compose.yaml down",
    "healenium:demo": "node scripts/healing-demo.mjs"
  },
  "keywords": [],
